# Set a real key only in your local environment or secret manager.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_URL=postgresql://user:password@localhost:5432/cv_assistant
DATA_ENCRYPTION_KEY=
CHECKPOINT_ENCRYPTION_KEY=
APP_ENV=development
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
DEPLOYMENT_JURISDICTIONS=
LEGAL_REVIEW_REFERENCE=
BIAS_AUDIT_REFERENCE=
PRIVACY_REVIEW_REFERENCE=
REVIEW_WORKFLOW_REFERENCE=
GROQ_ZERO_DATA_RETENTION=false
MAX_RESUME_CHARS=100000
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
SIMILARITY_THRESHOLD=0.85
GROQ_TIMEOUT_SECONDS=30
